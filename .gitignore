# =========================================================
# MikeShop V1 - Git Ignore
# =========================================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# SQLite database
*.db
*.sqlite
*.sqlite3

# Flask / local instance data
instance/

# Uploaded/local generated files
uploads/
receipts/

# Logs
*.log

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE/editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak