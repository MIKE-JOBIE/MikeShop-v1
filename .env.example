# =========================================================
# MikeShop V1 - Environment Variables
# Copy to .env and fill in real values
# =========================================================

# --- REQUIRED ---
SECRET_KEY=your-secret-key-here
OWNER_PASSWORD=your-owner-password

# --- DATABASE ---
# PostgreSQL for production
# Local development (SQLite). Set a PostgreSQL URL in Render/production.
DATABASE_URL=sqlite:///sneakers.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mikeShop

# --- EMAIL ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@mikeShop.com

# --- STORE ---
STORE_NAME=MikeShop
STORE_CURRENCY=USD
USD_TO_SLL=23000
STORE_URL=https://mikeShop.com
ONLINE_STORE_ENABLED=True

# --- SECURITY ---
CSRF_SECRET_KEY=your-csrf-secret
API_KEY=your-api-key-for-mobile
CORS_ORIGINS=https://mikeShop.com,https://api.mikeShop.com
# Leave empty for same-origin only; never use * in production.

# --- RATE LIMITING ---
RATELIMIT_ENABLED=True
REDIS_URL=redis://localhost:6379

# --- BACKUP ---
BACKUP_ENABLED=True
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# --- FLASK ---
FLASK_ENV=production  # development | production
# Optional social links
SOCIAL_FACEBOOK_URL=https://www.facebook.com/share/1Dd3pZPU5b/?mibextid=wwXIfr
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/mjobie2009?stkn=MTZzNmlha3VlNmVsaA%3D%3D&utm_source=qr
SOCIAL_LINKEDIN_URL=
SOCIAL_WHATSAPP_URL=
